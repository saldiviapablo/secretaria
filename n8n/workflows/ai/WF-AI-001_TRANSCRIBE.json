          {
            "node": "Gemini Files API Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI GPT-Transcribe": {
      "main": [
        [
          {
            "node": "Normalize Transcription Output",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Files API Upload": {
      "main": [
        [
          {
