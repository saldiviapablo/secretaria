{
  "name": "WF-AI-001_TRANSCRIBE",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "ai1-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const i = $input.first();\nconst j = i.json;\nconst p = j.payload || j;\nconst mode = p.mode || j.transcription_mode || 'production';\nconst provider = p.provider || j.transcription_provider || null;\nconst model = p.model || j.transcription_model || null;\nconst allowed = new Set(['openai:gpt-transcribe', 'gemini:gemini-3.5-transcribe']);\n\nif (mode === 'production' && (!provider || !model)) {\n  throw new Error('TRANSCRIPTION_PRIMARY_NOT_SELECTED: run approved benchmark before production routing (AI-DEC-007)');\n}\n\nif (!provider || !model || !allowed.has(`${provider}:${model}`)) {\n  throw new Error('TRANSCRIPTION_PROVIDER_MODEL_NOT_APPROVED: provider and model must match approved registry');\n}\n\nreturn [{\n  json: {\n    ...j,\n    transcription_mode: mode,\n    transcription_provider: provider,\n    transcription_model: model\n  },\n  binary: i.binary\n}];"
      },
      "id": "ai1-gate",
      "name": "Validate Transcription Contract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        340,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.transcription_provider }}",
                    "rightValue": "openai",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "openai"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.transcription_provider }}",
                    "rightValue": "gemini",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "gemini"
            }
          ]
        },
        "options": {}
      },
      "id": "ai1-switch",
      "name": "Provider Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/audio/transcriptions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "data"
            },
            {
              "name": "model",
              "value": "gpt-transcribe"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "ai1-openai",
      "name": "OpenAI GPT-Transcribe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        220
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "openai_dev_header_auth",
          "name": "SVIA_OPENAI_DEV_HEADER"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/upload/v1beta/files",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "={{ $binary.data.mimeType || 'audio/ogg' }}",
        "bodyParameters": {
          "parameters": []
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "ai1-gemini-upload",
      "name": "Gemini Files API Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "gemini_dev_header_auth",
          "name": "SVIA_GEMINI_DEV_HEADER"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemini-3.5-transcribe\",\n  \"input\": {\n    \"file_uri\": $json.file?.uri || $json.uri\n  },\n  \"transcription_config\": {\n    \"mode\": \"verbatim\",\n    \"language_code\": \"es-AR\"\n  }\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "ai1-gemini-interact",
      "name": "Gemini Transcribe Interaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "gemini_dev_header_auth",
          "name": "SVIA_GEMINI_DEV_HEADER"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst ctx = $('Validate Transcription Contract').first().json;\nconst text = j.text || j.transcript || j.output?.text || j.candidates?.[0]?.content?.parts?.[0]?.text || j.output_text || null;\nif (!text || !String(text).trim()) {\n  throw new Error('EMPTY_TRANSCRIPTION: provider returned empty transcript');\n}\n\nconst inputTokens = j.usage?.prompt_tokens ?? j.usageMetadata?.promptTokenCount ?? null;\nconst outputTokens = j.usage?.completion_tokens ?? j.usageMetadata?.candidatesTokenCount ?? null;\nconst reqId = j.id || j.responseId || j.interaction_id || null;\nconst durationMs = ctx.payload?.duration_ms || ctx.duration_ms || null;\nconst audioSec = durationMs ? Number((durationMs / 1000).toFixed(2)) : (j.duration ? Number(j.duration) : null);\n\nreturn [{\n  json: {\n    ...ctx,\n    transcript_text: String(text).trim(),\n    transcript_language: j.language || j.language_code || 'es-AR',\n    provider_request_id: reqId,\n    input_tokens: inputTokens,\n    output_tokens: outputTokens,\n    audio_seconds: audioSec,\n    estimated_cost_usd: null,\n    pricing_version: null,\n    raw_provider_metadata: {\n      has_segments: Array.isArray(j.segments),\n      has_words: Array.isArray(j.words)\n    }\n  }\n}];"
      },
      "id": "ai1-normalize",
      "name": "Normalize Transcription Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.create_source_text_variant($1::uuid, $2::uuid, $3::uuid, 'transcription', $4, $5, $6, $7, '1.0', true) AS res;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.ingestion_id, $json.asset_id, $json.transcript_text, $json.transcript_language, $json.transcription_provider, $json.transcription_model] }}"
        }
      },
      "id": "ai1-persist-source",
      "name": "Persist Literal Transcription",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.record_media_ai_usage($1::uuid, $2::uuid, $3::uuid, 'transcription', $4, $5, '1.0', $6, $7, $8, $9, NULL, $10, $11, $12::jsonb) AS id;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.ingestion_id, $json.asset_id, $('Normalize Transcription Output').first().json.transcription_provider, $('Normalize Transcription Output').first().json.transcription_model, $('Normalize Transcription Output').first().json.provider_request_id, $('Normalize Transcription Output').first().json.input_tokens, $('Normalize Transcription Output').first().json.output_tokens, $('Normalize Transcription Output').first().json.audio_seconds, $('Normalize Transcription Output').first().json.estimated_cost_usd, $('Normalize Transcription Output').first().json.pricing_version, JSON.stringify($('Normalize Transcription Output').first().json.raw_provider_metadata)] }}"
        }
      },
      "id": "ai1-record-usage",
      "name": "Record Transcription AI Usage",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const norm = $('Normalize Transcription Output').first().json;\nconst sourceRes = $('Persist Literal Transcription').first().json.res;\nconst stId = sourceRes.source_text_id || (typeof sourceRes === 'string' ? JSON.parse(sourceRes).source_text_id : null);\nconst usageId = $('Record Transcription AI Usage').first().json.id;\n\nreturn [{\n  json: {\n    ok: true,\n    status: 'completed',\n    ingestion_id: norm.ingestion_id,\n    asset_id: norm.asset_id,\n    source_text_id: stId,\n    transcript_text: norm.transcript_text,\n    provider: norm.transcription_provider,\n    model: norm.transcription_model,\n    usage_id: usageId\n  }\n}];"
      },
      "id": "ai1-format-output",
      "name": "Format Final Transcription",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1900,
        300
      ]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
