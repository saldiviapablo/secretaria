    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id FROM public.user_settings WHERE user_id IS NOT NULL ORDER BY created_at ASC LIMIT 1;",
        "options": {}
      },
      "id": "ing4-owner",
      "name": "Resolve DEV Owner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        360,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j=$input.first().json;\nconst id=j.id || j.fileId;\nconst modified=j.modifiedTime || j.modified_time || j.version;\nif(!id || !modified) throw new Error('DRIVE_EVENT_REQUIRES_FILE_ID_AND_VERSION');\nreturn [{json:{\n  contract_version:'1.0',\n  correlation_id:'corr_drive_'+crypto.randomUUID(),\n  user_id:j.user_id || null,\n  source_channel:'google_drive',\n  captured_at:j.modifiedTime || new Date().toISOString(),\n  timezone:j.timezone || 'America/Argentina/Buenos_Aires',\n  locale:j.locale || 'es-AR',\n  payload:{\n    drive_file_id:id,drive_version:String(modified),modifiedTime:j.modifiedTime || null,\n    original_filename:j.name || null,mime_type:j.mimeType || null,file_size:j.size ? Number(j.size) : null,\n    media_kind:(j.mimeType||'').startsWith('audio/')?'audio':((j.mimeType||'').startsWith('image/')?'image':'document')\n  },\n  idempotency_key:`drive:${id}:${modified}`\n}}];"
      },
      "id": "ing4-normalize",
      "name": "Normalize Drive Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.register_ingestion($1::uuid,'google_drive','drive_file',$2,$3::timestamptz,$4,NULL,NULL,NULL,NULL,NULL,$5,NULL,$6::jsonb) AS res;",
        "options": {
          "queryReplacement": "={{ [$json.user_id,$json.idempotency_key,$json.captured_at,$json.idempotency_key,$json.payload.drive_file_id,JSON.stringify({drive_version:$json.payload.drive_version,mime_type:$json.payload.mime_type,original_filename:$json.payload.original_filename,size_bytes:$json.payload.file_size})] }}"
        }
      },
      "id": "ing4-register",
      "name": "Register Drive Ingestion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        800,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "authentication": "oAuth2",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Normalize Drive Event').first().json.payload.drive_file_id }}"
        },
