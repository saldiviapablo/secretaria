{
  "name": "WF-ING-004_DRIVE_WATCH",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "mode": "id",
          "value": "SVIA_DRIVE_ROOT_FOLDER_ID_DEV__REQUIRED_BINDING"
        },
        "event": "fileCreated",
        "options": {}
      },
      "id": "ing4-created",
      "name": "Drive Trigger — Created",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        120,
        220
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      }
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "triggerOn": "specificFolder",
        "folderToWatch": {
          "__rl": true,
          "mode": "id",
          "value": "SVIA_DRIVE_ROOT_FOLDER_ID_DEV__REQUIRED_BINDING"
        },
        "event": "fileUpdated",
        "options": {}
      },
      "id": "ing4-updated",
      "name": "Drive Trigger — Updated",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [
        120,
        420
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst id = j.id || j.fileId;\nconst modified = j.modifiedTime || j.modified_time || j.version || new Date().toISOString();\nif (!id) throw new Error('DRIVE_EVENT_REQUIRES_FILE_ID');\n\nconst mime = String(j.mimeType || '').toLowerCase();\nconst mediaKind = mime.startsWith('audio/') ? 'audio' : (mime.startsWith('image/') ? 'image' : 'document');\n\nreturn [{\n  json: {\n    drive_file_id: id,\n    drive_version: String(modified),\n    modifiedTime: j.modifiedTime || modified,\n    original_filename: j.name || null,\n    mime_type: j.mimeType || null,\n    file_size: j.size ? Number(j.size) : null,\n    media_kind: mediaKind\n  }\n}];"
      },
      "id": "ing4-normalize",
      "name": "Normalize Drive Metadata",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id FROM public.user_settings WHERE user_id IS NOT NULL;",
        "options": {}
      },
      "id": "ing4-owner",
      "name": "Resolve V1 Owner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ownerRows = $input.all();\nif (!ownerRows || ownerRows.length === 0 || !ownerRows[0].json?.user_id) {\n  throw new Error('BLOCKED: NO_CONFIGURED_DRIVE_OWNER (no user found in user_settings)');\n}\nif (ownerRows.length > 1) {\n  throw new Error('BLOCKED: AMBIGUOUS_DRIVE_OWNER (expected exactly 1 configured owner in V1)');\n}\nconst userId = ownerRows[0].json.user_id;\nconst meta = $('Normalize Drive Metadata').first().json;\n\nreturn [{\n  json: {\n    contract_version: '1.0',\n    correlation_id: 'corr_drive_' + crypto.randomUUID(),\n    user_id: userId,\n    source_channel: 'google_drive',\n    captured_at: meta.modifiedTime || new Date().toISOString(),\n    timezone: 'America/Argentina/Buenos_Aires',\n    locale: 'es-AR',\n    idempotency_key: `drive:${meta.drive_file_id}:${meta.drive_version}`,\n    payload: {\n      ...meta\n    }\n  }\n}];"
      },
      "id": "ing4-merge",
      "name": "Merge Context and Enforce Single Owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.register_ingestion($1::uuid, 'google_drive', 'drive_file', $2, $3::timestamptz, $4, NULL, NULL, NULL, NULL, NULL, $5, NULL, $6::jsonb) AS res;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.idempotency_key, $json.captured_at, $json.idempotency_key, $json.payload.drive_file_id, JSON.stringify({drive_version:$json.payload.drive_version,mime_type:$json.payload.mime_type,original_filename:$json.payload.original_filename,size_bytes:$json.payload.file_size})] }}"
        }
      },
      "id": "ing4-register",
      "name": "Register Drive Ingestion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1020,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ingRaw = $('Register Drive Ingestion').first().json.res;\nconst ing = typeof ingRaw === 'string' ? JSON.parse(ingRaw) : ingRaw;\nconst ctx = $('Merge Context and Enforce Single Owner').first().json;\n\nif (ing.is_duplicate) {\n  return [{\n    json: {\n      ok: true,\n      status: 'duplicate',\n      ingestion_id: ing.ingestion_id,\n      message: 'Drive event already ingested'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...ctx,\n    ingestion_id: ing.ingestion_id\n  }\n}];"
      },
      "id": "ing4-check-duplicate",
      "name": "Check Ingestion Duplicate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1240,
        300
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.payload.drive_file_id }}"
        },
        "options": {}
      },
      "id": "ing4-download",
      "name": "Download File From Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1460,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "workflowId": "WF-ING-003",
        "options": {}
      },
      "id": "ing4-call-process",
      "name": "Call WF-ING-003_PROCESS_MEDIA",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1680,
        300
      ]
    }
  ],
  "connections": {
