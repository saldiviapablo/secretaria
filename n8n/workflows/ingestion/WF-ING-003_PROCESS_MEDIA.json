        "options": {
          "queryReplacement": "={{ [$json.user_id,$json.ingestion_id,$json.sha256,$json.payload.media_kind,$json.payload.original_filename,$json.payload.mime_type,$json.payload.file_size || null,$json.payload.duration_ms || null,$json.source_channel === 'google_drive' ? 'drive' : 'telegram',$json.external_id,$json.payload.drive_file_id || null,$json.payload.telegram_file_id || $json.payload.file_id || null,$json.payload.telegram_chat_id || $json.telegram_chat_id || null,$json.payload.telegram_message_id || $json.message_id || null,null,JSON.stringify({correlation_id:$json.correlation_id,source_channel:$json.source_channel})] }}"
        }
      },
