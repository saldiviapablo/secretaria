      "parameters": {
        "jsCode": "const item = $input.first();\nconst j = item.json;\nif (!j.user_id || !j.ingestion_id) {\n  throw new Error('F3_MEDIA_CONTRACT: user_id and ingestion_id required');\n}\nconst p = j.payload || j;\nconst kind = p.media_kind || p.media?.media_kind || null;\nconst fileSize = (typeof p.file_size === 'number' && p.file_size > 0) ? p.file_size : (typeof p.size_bytes === 'number' && p.size_bytes > 0 ? p.size_bytes : null);\nconst mime = String(p.mime_type || p.media?.mime_type || '').trim().toLowerCase();\nconst name = String(p.original_filename || p.media?.original_filename || '').trim().toLowerCase();\nconst source = j.source_channel || p.source_channel;\nif (!source) {\n  throw new Error('SOURCE_CHANNEL_REQUIRED: source_channel must be authenticated and present');\n}\n\nconst maxTelegramBytes = 20 * 1024 * 1024; // 20 MB Telegram Bot API limit\nconst forbiddenExt = /\\.(exe|com|bat|cmd|ps1|msi|scr|jar|js|vbs|wsf|sh|app|dmg|docm|xlsm|pptm|xlam|dotm|potm|ppam)$/i;\nconst forbiddenMime = /(x-msdownload|x-msdos-program|x-executable|x-sh|x-bat|javascript|vnd\\.ms-excel\\.sheet\\.macroEnabled|vnd\\.ms-word\\.document\\.macroEnabled|vnd\\.ms-powerpoint)/i;\n\nlet gate = 'download';\nif (source === 'telegram' && fileSize && fileSize > maxTelegramBytes) {\n  gate = 'awaiting_external_file';\n}\nif (forbiddenExt.test(name) || forbiddenMime.test(mime)) {\n  gate = 'quarantine';\n}\n\nlet route = 'unsupported';\nif (kind === 'audio' || /^audio\\//.test(mime)) {\n  route = 'transcribe';\n} else if (kind === 'image' || /^image\\//.test(mime)) {\n  route = 'visual';\n} else if (kind === 'document' || /(pdf|text|word|officedocument|spreadsheet|csv|json|xml|plain|html|rtf)/i.test(mime + ' ' + name)) {\n  route = 'document';\n}\n\nreturn [{\n  json: {\n    ...j,\n    source_channel: source,\n    payload: {\n      ...p,\n      media_kind: kind,\n      file_size: fileSize,\n      mime_type: mime || null,\n      original_filename: p.original_filename || p.media?.original_filename || null\n    },\n    media_gate: gate,\n    media_route: route\n  },\n  binary: item.binary\n}];"
      },
