      "id": "ing3-trigger",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        160,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst j = item.json;\nif (!j.user_id || !j.ingestion_id) throw new Error('F3_MEDIA_CONTRACT: user_id and ingestion_id required');\nconst p = j.payload || j;\nconst kind = p.media_kind || p.media?.media_kind;\nconst fileSize = Number(p.file_size ?? p.size_bytes ?? p.media?.file_size ?? 0);\nconst mime = String(p.mime_type || p.media?.mime_type || '').toLowerCase();\nconst name = String(p.original_filename || p.media?.original_filename || '').toLowerCase();\nconst source = j.source_channel || p.source_channel || 'telegram';\nconst max = 20 * 1024 * 1024; // Telegram standard Bot API getFile download limit verified at package build.\nconst forbiddenExt = /\\.(exe|com|bat|cmd|ps1|msi|scr|jar|js|vbs|wsf|sh|app|dmg|docm|xlsm|pptm|xlam|dotm|potm|ppam)$/i;\nconst forbiddenMime = /(x-msdownload|x-msdos-program|x-executable|x-sh|x-bat|javascript|vnd\\.ms-excel\\.sheet\\.macroEnabled|vnd\\.ms-word\\.document\\.macroEnabled|vnd\\.ms-powerpoint)/i;\nlet gate = 'download';\nif (source === 'telegram' && fileSize > max) gate = 'awaiting_external_file';\nif (forbiddenExt.test(name) || forbiddenMime.test(mime)) gate = 'quarantine';\nlet route = 'unsupported';\nif (kind === 'audio' || /^audio\\//.test(mime)) route = 'transcribe';\nelse if (kind === 'image' || /^image\\//.test(mime)) route = 'visual';\nelse if (kind === 'document' || /(pdf|text|word|officedocument|spreadsheet|csv|json|xml)/i.test(mime + ' ' + name)) route = 'document';\nreturn [{json:{...j,payload:{...p,media_kind:kind,file_size:fileSize,mime_type:mime,original_filename:p.original_filename || p.media?.original_filename || null},media_gate:gate,media_route:route},binary:item.binary}];"
      },
