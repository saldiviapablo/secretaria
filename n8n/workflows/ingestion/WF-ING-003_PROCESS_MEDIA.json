          "name": "SVIA_TELEGRAM_DEV"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(i => ({json:i.json,binary:i.binary}));"
      },
      "id": "ing3-drive-passthrough",
      "name": "Drive Binary Passthrough",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
