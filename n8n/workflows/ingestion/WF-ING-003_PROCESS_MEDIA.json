    {
      "parameters": {
        "resource": "file",
        "operation": "upload",
        "authentication": "oAuth2",
        "inputDataFieldName": "data",
        "name": "={{ $('Validate / Gate Media').first().json.payload.original_filename || ('svia-' + $('Validate / Gate Media').first().json.ingestion_id) }}",
        "driveId": {
          "__rl": true,
          "mode": "list",
          "value": "My Drive"
        },
        "folderId": {
