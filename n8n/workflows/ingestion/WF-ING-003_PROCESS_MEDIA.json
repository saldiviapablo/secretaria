      "id": "ing3-upload-drive",
      "name": "Archive Original in Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1420,
        360
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst j = item.json;\nconst p = j.payload || {};\nconst hash = j.sha256 || j.data || j.hash;\nif (!hash || !/^[0-9a-f]{64}$/i.test(hash)) throw new Error('SHA256_REQUIRED');\nconst source = j.source_channel || 'telegram';\nlet externalId;\nif (source === 'telegram') {\n  externalId = `telegram:${p.telegram_chat_id || j.telegram_chat_id}:${p.telegram_message_id || j.message_id}:${p.telegram_file_id || p.file_id || p.media?.file_id}`;\n} else if (source === 'google_drive') {\n  const fileId = p.drive_file_id || p.id;\n  const ver = p.drive_version || p.version || p.modifiedTime;\n  if (!fileId || !ver) throw new Error('DRIVE_VERSIONED_EXTERNAL_ID_REQUIRED');\n  externalId = `drive:${fileId}:${ver}`;\n} else throw new Error('UNSUPPORTED_MEDIA_SOURCE');\nreturn [{json:{...j,sha256:String(hash).toLowerCase(),external_id:externalId,asset_id:j.asset_id || null},binary:item.binary}];"
      },
