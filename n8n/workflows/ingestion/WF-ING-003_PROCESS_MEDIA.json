        "jsCode": "const item = $input.first();\nconst driveUpload = item.json;\nconst prev = $('Compute SHA-256 Preserving Binary').first().json;\nconst originalBinary = $('Compute SHA-256 Preserving Binary').first().binary;\nconst p = prev.payload || {};\n\nconst tgFileId = p.telegram_file_id || p.file_id || p.media?.file_id;\nconst tgChatId = p.telegram_chat_id || prev.telegram_chat_id;\nconst tgMsgId = p.telegram_message_id || prev.message_id;\nconst tgExternalId = `telegram:${tgChatId || '0'}:${tgMsgId || '0'}:${tgFileId || 'unknown'}`;\n\nconst driveFileId = driveUpload.id || p.drive_file_id || null;\nconst driveVer = driveUpload.modifiedTime || driveUpload.version || p.drive_version || '1';\nconst driveExternalId = driveFileId ? `drive:${driveFileId}:${driveVer}` : null;\n\nreturn [{\n  json: {\n    ...prev,\n    drive_upload_meta: driveUpload,\n    telegram_external_id: tgExternalId,\n    drive_external_id: driveExternalId,\n    payload: {\n      ...p,\n      drive_file_id: driveFileId,\n      drive_version: driveVer\n    }\n  },\n  binary: originalBinary\n}];"
