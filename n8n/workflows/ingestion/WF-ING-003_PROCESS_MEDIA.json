        "jsCode": "const item = $input.first();\nconst tgMeta = item.json;\nconst prev = $('Validate / Gate Media').first().json;\n\nreturn [{\n  json: {\n    ...prev,\n    telegram_download_meta: tgMeta,\n    payload: {\n      ...prev.payload,\n      telegram_file_id: tgMeta.file_id || prev.payload?.telegram_file_id || prev.payload?.file_id,\n      telegram_file_unique_id: tgMeta.file_unique_id || null,\n      file_size: tgMeta.file_size || prev.payload?.file_size || null\n    }\n  },\n  binary: item.binary\n}];"
