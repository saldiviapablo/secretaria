      "id": "ing3-drive-passthrough",
      "name": "Drive Binary Passthrough",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst item = $input.first();\nconst j = item.json;\n\nif (!item.binary || !item.binary.data) {\n  throw new Error('BINARY_DATA_REQUIRED: binary audio/media stream not found');\n}\n\nlet buffer = null;\nif (this.helpers && typeof this.helpers.getBinaryDataBuffer === 'function') {\n  buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n} else if (item.binary.data.data) {\n  buffer = Buffer.isBuffer(item.binary.data.data) ? item.binary.data.data : Buffer.from(item.binary.data.data, 'base64');\n}\n\nif (!buffer || buffer.length === 0) {\n  throw new Error('EMPTY_BINARY_BUFFER: binary media buffer is empty');\n}\n\nconst sha256 = crypto.createHash('sha256').update(buffer).digest('hex').toLowerCase();\nconst exactBytes = buffer.length;\n\nreturn [{\n  json: {\n    ...j,\n    sha256: sha256,\n    exact_byte_length: exactBytes,\n    payload: {\n      ...j.payload,\n      file_size: exactBytes\n    }\n  },\n  binary: item.binary\n}];"
      },
