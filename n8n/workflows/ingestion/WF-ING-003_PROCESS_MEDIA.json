    {
      "parameters": {
        "jsCode": "const ctx = $('Validate / Gate Media').first().json;\nconst notificationText = '⚠️ El archivo supera el límite de 20 MB de Telegram Bot API. Por favor, sube el archivo original directamente a la carpeta de Google Drive configurada (/SECRETARIA_VIRTUAL) para que pueda ser procesado.';\n\nreturn [{\n  json: {\n    correlation_id: ctx.correlation_id || ('corr_large_' + crypto.randomUUID()),\n    user_id: ctx.user_id,\n    delivery_class: 'reactive',\n    text: notificationText,\n    is_critical: false,\n    payload: {\n      text: notificationText,\n      delivery_class: 'reactive',\n      is_critical: false\n    }\n  }\n}];"
      },
