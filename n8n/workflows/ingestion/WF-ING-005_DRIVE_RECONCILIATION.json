{
  "name": "WF-ING-005_DRIVE_RECONCILIATION",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "ing5-schedule",
      "name": "Schedule 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        120,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT user_id FROM public.user_settings WHERE user_id IS NOT NULL;",
        "options": {}
      },
      "id": "ing5-owner",
      "name": "Resolve V1 Owner",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        340,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const ownerRows = $input.all();\nif (!ownerRows || ownerRows.length === 0 || !ownerRows[0].json?.user_id) {\n  throw new Error('BLOCKED: NO_CONFIGURED_DRIVE_OWNER (no user found in user_settings)');\n}\nif (ownerRows.length > 1) {\n  throw new Error('BLOCKED: AMBIGUOUS_DRIVE_OWNER (expected exactly 1 configured owner in V1)');\n}\nreturn [{json:{user_id:ownerRows[0].json.user_id}}];"
      },
      "id": "ing5-validate-owner",
      "name": "Validate Single V1 Owner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "authentication": "oAuth2",
        "returnAll": true,
        "searchMethod": "query",
        "queryString": "trashed = false",
        "filter": {
          "folderId": {
            "__rl": true,
            "mode": "id",
            "value": "={{ $env.SVIA_DRIVE_ROOT_FOLDER_ID_DEV || 'SVIA_DRIVE_ROOT_FOLDER_ID_DEV' }}"
          },
          "whatToSearch": "files"
        },
        "options": {
          "fields": [
            "id",
            "name",
            "mimeType",
            "modifiedTime",
            "size"
          ]
        }
      },
      "id": "ing5-search",
      "name": "List Root Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        780,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT external_id, drive_file_id, last_verified_at FROM public.asset_locations WHERE user_id = $1::uuid AND location_type = 'drive';",
        "options": {
          "queryReplacement": "={{ [$('Validate Single V1 Owner').first().json.user_id] }}"
        }
      },
      "id": "ing5-query-locations",
      "name": "Query Existing Asset Locations",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1000,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const owner = $('Validate Single V1 Owner').first().json.user_id;\nconst files = $('List Root Files').all().map(i => i.json);\nconst existingLocRows = $input.all().map(i => i.json);\nconst knownKeys = new Set(existingLocRows.map(r => r.external_id));\n\nconst candidates = [];\nfor (const f of files) {\n  if (!f.id) continue;\n  const ver = f.modifiedTime || f.version || f.drive_version;\n  if (!ver) {\n    throw new Error(`DRIVE_VERSION_METADATA_REQUIRED: Missing real version metadata for file ${f.id}`);\n  }\n  const expectedKey = `drive:${f.id}:${ver}`;\n  if (!knownKeys.has(expectedKey)) {\n    const mime = String(f.mimeType || '').toLowerCase();\n    const mediaKind = mime.startsWith('audio/') ? 'audio' : (mime.startsWith('image/') ? 'image' : 'document');\n    candidates.push({\n      json: {\n        contract_version: '1.0',\n        correlation_id: 'corr_recon_' + crypto.randomUUID(),\n        user_id: owner,\n        source_channel: 'google_drive',\n        captured_at: f.modifiedTime,\n        idempotency_key: expectedKey,\n        payload: {\n          drive_file_id: f.id,\n          drive_version: String(ver),\n          modifiedTime: f.modifiedTime || null,\n          original_filename: f.name || null,\n          mime_type: f.mimeType || null,\n          file_size: f.size ? Number(f.size) : null,\n          media_kind: mediaKind,\n          reconciled: true\n        }\n      }\n    });\n  }\n}\n\nreturn candidates;"
      },
      "id": "ing5-reconcile-filter",
      "name": "Filter Unindexed or Modified Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT public.register_ingestion($1::uuid, 'google_drive', 'drive_reconciliation', $2, $3::timestamptz, $4, NULL, NULL, NULL, NULL, NULL, $5, NULL, $6::jsonb) AS res;",
        "options": {
          "queryReplacement": "={{ [$json.user_id, $json.idempotency_key, $json.captured_at, $json.idempotency_key, $json.payload.drive_file_id, JSON.stringify({drive_version:$json.payload.drive_version,reconciled:true,mime_type:$json.payload.mime_type,original_filename:$json.payload.original_filename,size_bytes:$json.payload.file_size})] }}"
        }
      },
      "id": "ing5-register",
      "name": "Register Reconciled Ingestion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "supabase_dev_connection",
          "name": "Supabase DEV Database"
        }
      }
    },
    {
      "parameters": {
        "resource": "file",
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.payload.drive_file_id }}"
        },
        "options": {}
      },
      "id": "ing5-download",
      "name": "Download Missed File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        1660,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "drive_dev_connection",
          "name": "SVIA_DRIVE_DEV"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "workflowId": "WF-ING-003",
        "options": {}
      },
      "id": "ing5-call-process",
      "name": "Call WF-ING-003_PROCESS_MEDIA",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1880,
        300
      ]
    }
  ],
  "connections": {
    "Schedule 15 Minutes": {
      "main": [
        [
          {
            "node": "Resolve V1 Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve V1 Owner": {
      "main": [
        [
          {
            "node": "Validate Single V1 Owner",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Single V1 Owner": {
      "main": [
        [
          {
            "node": "List Root Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List Root Files": {
      "main": [
        [
          {
            "node": "Query Existing Asset Locations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Existing Asset Locations": {
      "main": [
        [
          {
            "node": "Filter Unindexed or Modified Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter Unindexed or Modified Files": {
      "main": [
        [
          {
            "node": "Register Reconciled Ingestion",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Reconciled Ingestion": {
      "main": [
        [
          {
            "node": "Download Missed File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Missed File": {
      "main": [
        [
          {
            "node": "Call WF-ING-003_PROCESS_MEDIA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "WF-SYS-001"
  },
  "id": "WF-ING-005"
}
